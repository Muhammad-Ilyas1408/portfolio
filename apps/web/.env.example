# Copy to apps/web/.env.local for local development. Never commit .env files.
# Only NEXT_PUBLIC_* variables exist here, and every one of them is PUBLIC:
# it is inlined into the browser bundle when `next build` runs. Never put a
# secret (such as the Resend key) in this app.
#
# On Vercel (docs/DEPLOY.md, step 4) both must be set BEFORE the first build.
# A production build fails if either is missing, not https, or localhost.

# Base URL of the contact API (feeds the contact form and the CSP connect-src).
# Production: https://muhammad-ilyas-api.vercel.app (or the API project's real URL).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of the site, used for metadataBase, canonicals, Open Graph
# URLs, the sitemap, robots and JSON-LD.
# Production: https://muhammad-ilyas.vercel.app (or the web project's real URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Smoke test only (pnpm --filter web test:smoke), read-only, never needed by the
# build. Set it in your terminal, not in Vercel. See docs/DEPLOY.md, step 6.
# SMOKE_BASE_URL=https://muhammad-ilyas.vercel.app
