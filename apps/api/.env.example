# Copy to apps/api/.env for local development. Never commit .env.
# Empty values fall back to the defaults in app/config.py. See docs/API.md.
# Production values (set in the Vercel API project, never in a file) are in docs/DEPLOY.md.

# "development" (default) or "production". Production disables /docs and needs RESEND_API_KEY.
ENV=development

# Resend API key ("Sending access" only). Optional in development: without it, messages are
# accepted and dropped. Production: paste it only into Vercel's Environment Variables screen.
RESEND_API_KEY=

# Where notifications go (default: muhammadilyas.ai.eng@gmail.com). With the test sender below,
# Resend delivers only to the Resend account's own address, so keep the two the same.
CONTACT_TO_EMAIL=
# Sender (default: "Portfolio Contact <onboarding@resend.dev>", Resend's test sender).
CONTACT_FROM_EMAIL=

# Comma-separated exact origins allowed by CORS. Production: https://muhammad-ilyas.vercel.app
# (or the web project's real URL if that name was taken).
CORS_ALLOW_ORIGINS=http://localhost:3000
# Optional regex for extra origins, matched against the whole origin (e.g. this project's own
# Vercel previews; pattern in docs/DEPLOY.md). Leave empty to allow the exact origins only.
CORS_ALLOW_ORIGIN_REGEX=

# Per client IP, on POST /contact only (default 5/10minutes). On Vercel the count is kept per
# function instance, not globally.
RATE_LIMIT=5/10minutes
# true only behind a proxy that overwrites X-Forwarded-For (Vercel does: set true there).
TRUST_PROXY_HEADERS=false
