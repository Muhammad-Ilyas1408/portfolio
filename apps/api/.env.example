# Copy to apps/api/.env for local development. Never commit .env.
# Empty values fall back to the defaults in app/config.py. See docs/API.md.

# "development" (default) or "production". Production disables /docs and needs RESEND_API_KEY.
ENV=development

# Resend API key. Optional in development: without it, messages are accepted and dropped.
RESEND_API_KEY=

# Where notifications go (default: muhammadilyas.ai.eng@gmail.com).
CONTACT_TO_EMAIL=
# Sender (default: "Portfolio Contact <onboarding@resend.dev>", Resend's test sender).
CONTACT_FROM_EMAIL=

# Comma-separated exact origins allowed by CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Optional regex for extra origins (e.g. your own Vercel previews). Must match the whole origin.
CORS_ALLOW_ORIGIN_REGEX=

# Per client IP, on POST /contact only (default 5/10minutes).
RATE_LIMIT=5/10minutes
# true only behind a proxy that sets X-Forwarded-For (the first address is used).
TRUST_PROXY_HEADERS=false
